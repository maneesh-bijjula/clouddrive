CLOUDDRIVE_DATABASE_URL=postgresql+psycopg://clouddrive:clouddrive@localhost:5435/clouddrive
CLOUDDRIVE_REDIS_URL=redis://localhost:6382/0
CLOUDDRIVE_S3_ENDPOINT=http://localhost:9000
CLOUDDRIVE_S3_PUBLIC_ENDPOINT=http://localhost:9000
CLOUDDRIVE_S3_ACCESS_KEY=clouddrive
CLOUDDRIVE_S3_SECRET_KEY=clouddrive-local
CLOUDDRIVE_S3_BUCKET=clouddrive
# Decimal 5 GB; part sizes remain binary MiB (8 MiB by default).
CLOUDDRIVE_MAX_FILE_BYTES=5000000000

# Concurrent upload admission and bounded API database pool.
CLOUDDRIVE_MAX_ACTIVE_UPLOADS_PER_WORKSPACE=10
CLOUDDRIVE_MAX_ACTIVE_UPLOADS_GLOBAL=100
CLOUDDRIVE_MAX_API_INFLIGHT=64
CLOUDDRIVE_DB_POOL_SIZE=8
CLOUDDRIVE_DB_MAX_OVERFLOW=8
CLOUDDRIVE_DB_POOL_TIMEOUT_SECONDS=10
CLOUDDRIVE_ADMISSION_LOCK_TIMEOUT_SECONDS=5
# Browser ceilings may be lowered; active files also clamp to global part slots.
CLOUDDRIVE_BROWSER_ACTIVE_FILES=10
CLOUDDRIVE_BROWSER_HASH_WORKERS=2
CLOUDDRIVE_BROWSER_GLOBAL_PARTS=10
CLOUDDRIVE_BROWSER_PARTS_PER_FILE=3
# Optional operational metrics credential, separate from workspace access.
# Empty disables /api/ops. Supply a private value before enabling outside tests.
CLOUDDRIVE_METRICS_KEY=
