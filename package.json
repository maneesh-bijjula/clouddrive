{
  "name": "clouddrive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite frontend --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build frontend --outDir ../dist --emptyOutDir",
    "test:browser": "playwright test",
    "format": "prettier --write frontend tests-browser *.json *.ts .github README.md compose.yaml",
    "bench:upload": "node scripts/benchmark-upload.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "lucide": "1.59.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
